{
  "id": "zen-peek",
  "name": "Zen Peek",
  "description": "Arc-style hover previews for Zen Essentials: your latest Gmail, today's Google Calendar, GitHub notifications, Hacker News, or a snapshot of the page.",
  "homepage": "https://github.com/hajorda/ZenPeek",
  "readme": "https://raw.githubusercontent.com/hajorda/ZenPeek/main/README.md",
  "image": "https://raw.githubusercontent.com/hajorda/ZenPeek/main/assets/logo.png",
  "author": "hajorda",
  "version": "0.1.0",
  "style": { "chrome": "mod/userChrome.css" },
  "preferences": "mod/preferences.json",
  "scripts": {
    "mod/core.uc.js": { "include": ["chrome://browser/content/browser.xhtml"], "loadOrder": 10 },
    "mod/sources.uc.js": { "include": ["chrome://browser/content/browser.xhtml"], "loadOrder": 11 },
    "mod/zen-adapter.uc.js": { "include": ["chrome://browser/content/browser.xhtml"], "loadOrder": 12 },
    "mod/peek.uc.js": { "include": ["chrome://browser/content/browser.xhtml"], "loadOrder": 13 }
  },
  "tags": ["Essentials", "Preview", "Gmail", "Calendar", "Productivity"],
  "fork": ["zen"]
}
